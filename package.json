{
  "name": "@graciousstar/node-red-contrib-vision-tools",
  "version": "1.2.0",
  "description": "Machine-vision nodes for Node-RED on a fixed camera rig: golden-template AOI with position and blemish tolerances, mm/px calibration and camera perspective from a checkerboard, deskew-and-crop of a physical label, caliper edge and line finding over a drawn region, and barcode location and decoding restricted to known regions.",
  "license": "Apache-2.0",
  "author": "GraciousStar",
  "keywords": [
    "node-red",
    "image",
    "vision",
    "machine-vision",
    "qc",
    "aoi",
    "inspection",
    "golden-template",
    "calibration",
    "checkerboard",
    "caliper",
    "edge-detection",
    "line-finder",
    "barcode",
    "datamatrix",
    "qr",
    "code128",
    "sharp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GraciousGpal/node-red-contrib-vision-tools.git"
  },
  "bugs": {
    "url": "https://github.com/GraciousGpal/node-red-contrib-vision-tools/issues"
  },
  "homepage": "https://github.com/GraciousGpal/node-red-contrib-vision-tools#readme",
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "golden-compare": "golden-compare.js",
      "checkerboard-calibrate": "checkerboard-calibrate.js",
      "perspective-rectify": "perspective-rectify.js",
      "label-crop": "label-crop.js",
      "line-finder": "line-finder.js",
      "barcode-locate": "barcode-locate.js",
      "synthetic-defects": "synthetic-defects.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:count": "bash scripts/readme-test-count.sh",
    "dev:push": "bash scripts/dev-push.sh",
    "deploy:vendor": "bash scripts/vendor-deploy.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "zxing-wasm": "^3.1.3"
  },
  "optionalDependencies": {
    "@rosepetal/node-red-contrib-image-tools": "^1.6.4",
    "@techstark/opencv-js": "^5.0.0-release.1"
  },
  "allowScripts": {
    "sharp@0.35.4": true,
    "@rosepetal/node-red-contrib-image-tools@1.7.0": true
  },
  "files": [
    "*.js",
    "*.html",
    "lib/",
    "prebuilds/",
    "native/kernels.cc",
    "native/binding.gyp",
    "native/build.sh",
    "icons/",
    "examples/",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
